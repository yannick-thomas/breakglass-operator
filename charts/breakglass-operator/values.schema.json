{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.:/_-]*[a-z0-9]$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest",
        "tag",
        "pullPolicy"
      ],
      "oneOf": [
        {
          "properties": {
            "digest": {
              "minLength": 1
            },
            "tag": {
              "maxLength": 0
            }
          }
        },
        {
          "properties": {
            "tag": {
              "minLength": 1
            },
            "digest": {
              "maxLength": 0
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "allowedTargetNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      }
    },
    "curatedClusterRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "maxLength": 253
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spreadAcrossHosts": {
          "type": "boolean"
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "enabled",
            "minAvailable"
          ]
        }
      },
      "required": [
        "spreadAcrossHosts",
        "podDisruptionBudget"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "group": {
              "const": "cert-manager.io"
            }
          },
          "dependencies": {
            "name": [
              "kind"
            ],
            "kind": [
              "name"
            ],
            "group": [
              "name",
              "kind"
            ]
          }
        }
      },
      "required": [
        "issuerRef"
      ]
    },
    "expiryGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "grace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "timeout": {
          "type": "string",
          "minLength": 1,
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        }
      },
      "required": [
        "schedule",
        "grace",
        "timeout",
        "activeDeadlineSeconds",
        "resources"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "type": "string",
              "minLength": 1,
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
            },
            "caSecretName": {
              "type": "string"
            },
            "caSecretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled",
            "labels",
            "interval",
            "caSecretName",
            "caSecretKey"
          ]
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled",
            "labels"
          ]
        }
      },
      "required": [
        "serviceMonitor",
        "prometheusRule"
      ]
    },
    "webui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9.:/_-]*[a-z0-9]$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            },
            "tag": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "digest",
            "tag",
            "pullPolicy"
          ]
        },
        "publicURL": {
          "type": "string"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerURL": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "issuerURL",
            "clientID",
            "existingSecret",
            "clientSecretKey"
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "host": {
              "type": "string"
            },
            "tlsSecretName": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "className",
            "annotations",
            "host",
            "tlsSecretName"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        }
      },
      "required": [
        "enabled",
        "image",
        "publicURL",
        "oidc",
        "ingress",
        "resources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "oneOf": [
                  {
                    "properties": {
                      "digest": {
                        "minLength": 1
                      },
                      "tag": {
                        "maxLength": 0
                      }
                    }
                  },
                  {
                    "properties": {
                      "tag": {
                        "minLength": 1
                      },
                      "digest": {
                        "maxLength": 0
                      }
                    }
                  }
                ]
              },
              "publicURL": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https://[^/?#@]+$"
              },
              "oidc": {
                "properties": {
                  "issuerURL": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^https://[^?#]+$"
                  },
                  "clientID": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "ingress": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "host": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tlsSecretName": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "global": {
      "type": "object",
      "maxProperties": 0
    }
  },
  "required": [
    "image",
    "imagePullSecrets",
    "allowedTargetNamespaces",
    "curatedClusterRoles",
    "replicaCount",
    "availability",
    "resources",
    "nodeSelector",
    "tolerations",
    "podAnnotations",
    "priorityClassName",
    "certManager",
    "expiryGuard",
    "metrics",
    "webui"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "metrics": {
            "properties": {
              "serviceMonitor": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "serviceMonitor": {
                "properties": {
                  "caSecretName": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
