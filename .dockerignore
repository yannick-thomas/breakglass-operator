# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include the manager source directories (but not *_test.go).  Directories
# must be re-included too: some builders do not descend into a directory that
# remains excluded, even if an individual Go-file pattern is later negated.
!cmd/
!cmd/**
!api/
!api/**
!internal/
!internal/**
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# The WebUI image builds its frontend from source in a Node stage.
internal/webui/frontend/node_modules
internal/webui/frontend/build/app
internal/webui/frontend/test-results
internal/webui/frontend/playwright-report
