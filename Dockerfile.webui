# Build the React frontend. Install scripts stay disabled: no dependency needs
# one, and this keeps a compromised package from running code at build time.
ARG NODE_IMAGE=node:24-alpine
ARG BASE_IMAGE=golang:1.26
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS frontend
WORKDIR /frontend
COPY internal/webui/frontend/package.json internal/webui/frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-fund --no-audit
COPY internal/webui/frontend/ ./
RUN npm run build

# Build the WebUI binary with the frontend embedded
FROM --platform=$BUILDPLATFORM ${BASE_IMAGE} AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

# Copy the go source
COPY api/ api/
COPY internal/ internal/
COPY cmd/ cmd/
COPY --from=frontend /frontend/build/app internal/webui/frontend/build/app

# Build WebUI binary
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o breakglass-webui ./cmd/webui

# Use distroless as minimal base image to package the manager binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/breakglass-webui .
USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/breakglass-webui"]
